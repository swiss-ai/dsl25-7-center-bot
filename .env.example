# Slack Configuration
SLACK_APP_TOKEN=xapp-1-YOUR-APP-TOKEN
SLACK_BOT_TOKEN=xoxb-YOUR-BOT-TOKEN
SLACK_SIGNING_SECRET=your-signing-secret

# Claude API
CLAUDE_API_KEY=your-claude-api-key

# Vector Database (ChromaDB)
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_API_TOKEN=your-secure-token-here

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://redis:6379/0

# Google Services (for Drive, Calendar, Email integrations)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth2callback
GOOGLE_DRIVE_CLIENT_ID=your-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-refresh-token

# Notion Integration
NOTION_API_KEY=your-notion-api-key
NOTION_DATABASE_ID=your-database-id

# Airtable Integration
AIRTABLE_API_KEY=your-airtable-api-key
AIRTABLE_BASE_ID=your-base-id

# OpenAI (for embeddings if not using Claude)
OPENAI_API_KEY=your-openai-api-key

# Calendar Configuration
CALENDAR_CLIENT_ID=your-calendar-client-id
CALENDAR_CLIENT_SECRET=your-calendar-client-secret

# Wiki Configuration
WIKI_API_URL=https://your-wiki.com/api
WIKI_USERNAME=your-username
WIKI_PASSWORD=your-password

# Email Configuration
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
MAX_REQUESTS_PER_MINUTE=60
MAX_REQUESTS_PER_USER=20

# Web Scraping
SELENIUM_DRIVER_PATH=/usr/bin/chromedriver
HEADLESS_BROWSER=true

# Security
JWT_SECRET_KEY=your-jwt-secret-key
SESSION_SECRET_KEY=your-session-secret-key

# Database (if using SQL for conversation history)
DATABASE_URL=sqlite:///data/conversations.db

# Monitoring (optional)
SENTRY_DSN=your-sentry-dsn
PROMETHEUS_ENABLED=false